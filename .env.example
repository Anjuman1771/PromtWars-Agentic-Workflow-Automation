# ==============================================================================
# FlowPilot AI - Environment Configuration Template
# Copy this file to .env and provide your values.
# IMPORTANT: Never commit actual .env files or secrets to source control.
# ==============================================================================

# Application Environment
FLOWPILOT_ENV=development
FLOWPILOT_DEBUG=true
FLOWPILOT_HOST=127.0.0.1
FLOWPILOT_PORT=8000

# Security & CORS
FLOWPILOT_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
FLOWPILOT_SECRET_KEY=change-this-in-production-to-a-secure-random-string

# AI / Gemini Configuration
# Leave blank to run in offline Deterministic Mock / Heuristic Mode (Zero-cost / offline)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Execution & Safety Limits
FLOWPILOT_MAX_WORKFLOW_STEPS=30
FLOWPILOT_MAX_RUN_TIME_SECONDS=300
FLOWPILOT_DEFAULT_TASK_TIMEOUT_SECONDS=30
FLOWPILOT_MAX_RESPONSE_SIZE_BYTES=2097152

# Human-in-the-Loop (HITL) Settings
FLOWPILOT_APPROVAL_TTL_SECONDS=600

# Storage
FLOWPILOT_DB_PATH=flowpilot.db

# File Workspace Root (Containment Boundary)
# Defaults to repository directory if left empty
FLOWPILOT_WORKSPACE_ROOT=
